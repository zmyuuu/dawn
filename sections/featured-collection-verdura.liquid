<style>
  .verdura-featured-collection {
    padding: 80px 0;
    background: #fafafa;
  }

  .verdura-featured-collection__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .verdura-featured-collection__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .verdura-featured-collection__title {
    font-size: 48px;
    font-weight: 300;
    color: #1a1a1a;
    margin-bottom: 20px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .verdura-featured-collection__description {
    font-size: 18px;
    color: #666;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .verdura-featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 40px;
    margin-bottom: 60px;
  }

  .verdura-featured-collection__filters {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .verdura-featured-collection__filter-button {
    padding: 12px 24px;
    border: 1px solid #1a1a1a;
    background: transparent;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 500;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .verdura-featured-collection__filter-button:hover,
  .verdura-featured-collection__filter-button.active {
    background: #1a1a1a;
    color: white;
  }

  .verdura-featured-collection__view-all {
    text-align: center;
  }

  .verdura-featured-collection__view-all-button {
    display: inline-block;
    padding: 16px 32px;
    border: 2px solid #1a1a1a;
    background: transparent;
    color: #1a1a1a;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    border-radius: 4px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .verdura-featured-collection__view-all-button:hover {
    background: #1a1a1a;
    color: white;
  }

  .verdura-featured-collection__sort {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin-bottom: 40px;
  }

  .verdura-featured-collection__sort-label {
    font-size: 14px;
    color: #666;
    font-weight: 500;
  }

  .verdura-featured-collection__sort-select {
    padding: 8px 16px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
    background: white;
    color: #333;
  }

  @media (max-width: 768px) {
    .verdura-featured-collection {
      padding: 60px 0;
    }

    .verdura-featured-collection__title {
      font-size: 32px;
    }

    .verdura-featured-collection__grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .verdura-featured-collection__filters {
      gap: 15px;
    }

    .verdura-featured-collection__filter-button {
      padding: 10px 20px;
      font-size: 12px;
    }
  }
</style>

<div class="verdura-featured-collection">
  <div class="verdura-featured-collection__container">
    <div class="verdura-featured-collection__header">
      <h2 class="verdura-featured-collection__title">
        {% if section.settings.title != blank %}
          {{ section.settings.title }}
        {% else %}
          The Collection
        {% endif %}
      </h2>
      
      {% if section.settings.description != blank %}
        <p class="verdura-featured-collection__description">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    {% if section.settings.show_filters %}
      <div class="verdura-featured-collection__filters">
        <button class="verdura-featured-collection__filter-button active" data-filter="all">All</button>
        <button class="verdura-featured-collection__filter-button" data-filter="bracelets">Bracelets & Watches</button>
        <button class="verdura-featured-collection__filter-button" data-filter="necklaces">Necklaces</button>
        <button class="verdura-featured-collection__filter-button" data-filter="rings">Rings</button>
        <button class="verdura-featured-collection__filter-button" data-filter="earclips">Earclips</button>
      </div>
    {% endif %}

    {% if section.settings.show_sort %}
      <div class="verdura-featured-collection__sort">
        <span class="verdura-featured-collection__sort-label">Sort By:</span>
        <select class="verdura-featured-collection__sort-select">
          <option value="best-selling">Best Sellers</option>
          <option value="price-ascending">Price, low to high</option>
          <option value="price-descending">Price, high to low</option>
          <option value="created-ascending">New Arrivals</option>
        </select>
      </div>
    {% endif %}

    <div class="verdura-featured-collection__grid">
      {% assign collection = collections[section.settings.collection] %}
      {% assign products_to_show = section.settings.products_to_show | default: 6 %}
      
      {% for product in collection.products limit: products_to_show %}
        <div class="verdura-product-card" data-category="{{ product.type | downcase }}">
          {% render 'product-card-verdura', product: product %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_view_all %}
      <div class="verdura-featured-collection__view-all">
        <a href="{{ collection.url }}" class="verdura-featured-collection__view-all-button">
          View All Products
        </a>
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Filter functionality
    const filterButtons = document.querySelectorAll('.verdura-featured-collection__filter-button');
    const productCards = document.querySelectorAll('.verdura-product-card');

    filterButtons.forEach(button => {
      button.addEventListener('click', function() {
        const filter = this.getAttribute('data-filter');
        
        // Update active button
        filterButtons.forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');
        
        // Filter products
        productCards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category').includes(filter)) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Sort functionality
    const sortSelect = document.querySelector('.verdura-featured-collection__sort-select');
    if (sortSelect) {
      sortSelect.addEventListener('change', function() {
        const sortValue = this.value;
        const grid = document.querySelector('.verdura-featured-collection__grid');
        const products = Array.from(grid.children);
        
        products.sort((a, b) => {
          const priceA = parseFloat(a.querySelector('.verdura-product-card__price').textContent.replace(/[^0-9.]/g, ''));
          const priceB = parseFloat(b.querySelector('.verdura-product-card__price').textContent.replace(/[^0-9.]/g, ''));
          
          if (sortValue === 'price-ascending') {
            return priceA - priceB;
          } else if (sortValue === 'price-descending') {
            return priceB - priceA;
          }
          return 0;
        });
        
        products.forEach(product => grid.appendChild(product));
      });
    }
  });
</script>

{% schema %}
{
  "name": "Verdura Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our most popular jewelry pieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show category filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort options",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Verdura Featured Collection"
    }
  ]
}
{% endschema %} 
