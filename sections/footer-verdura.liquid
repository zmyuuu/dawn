<style>
  .verdura-footer {
    background-color: #1a1a1a;
    color: white;
    padding: 60px 0 40px;
  }

  .verdura-footer__content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .verdura-footer__top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid #333;
  }

  .verdura-footer__logo {
    margin-bottom: 20px;
  }

  .verdura-footer__logo img {
    max-height: 40px;
    width: auto;
  }

  .verdura-footer__description {
    color: #999;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .verdura-footer__social {
    display: flex;
    gap: 15px;
  }

  .verdura-footer__social-link {
    color: white;
    text-decoration: none;
    font-size: 18px;
    transition: color 0.3s ease;
  }

  .verdura-footer__social-link:hover {
    color: #d4af37;
  }

  .verdura-footer__section-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .verdura-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .verdura-footer__link-item {
    margin-bottom: 12px;
  }

  .verdura-footer__link {
    color: #999;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s ease;
  }

  .verdura-footer__link:hover {
    color: #d4af37;
  }

  .verdura-footer__contact-info {
    color: #999;
    font-size: 14px;
    line-height: 1.6;
  }

  .verdura-footer__contact-info p {
    margin-bottom: 8px;
  }

  .verdura-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
    border-top: 1px solid #333;
  }

  .verdura-footer__copyright {
    color: #666;
    font-size: 12px;
  }

  .verdura-footer__bottom-links {
    display: flex;
    gap: 20px;
  }

  .verdura-footer__bottom-link {
    color: #666;
    text-decoration: none;
    font-size: 12px;
    transition: color 0.3s ease;
  }

  .verdura-footer__bottom-link:hover {
    color: #d4af37;
  }

  @media (max-width: 768px) {
    .verdura-footer__top {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .verdura-footer__bottom {
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }
  }
</style>

<footer class="verdura-footer">
  <div class="verdura-footer__content">
    <div class="verdura-footer__top">
      <div class="verdura-footer__main">
        <div class="verdura-footer__logo">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="200" height="40">
          {% else %}
            <span style="font-size: 24px; font-weight: 300; letter-spacing: 2px;">VERDURA</span>
          {% endif %}
        </div>
        <p class="verdura-footer__description">
          Founded in 1939 by Duke Fulco di Verdura, the jeweler is known for its timeless, elegant and distinctly original designs.
        </p>
        <div class="verdura-footer__social">
          <a href="#" class="verdura-footer__social-link">📘</a>
          <a href="#" class="verdura-footer__social-link">📷</a>
          <a href="#" class="verdura-footer__social-link">📺</a>
        </div>
      </div>

      <div class="verdura-footer__section">
        <h3 class="verdura-footer__section-title">Contact</h3>
        <div class="verdura-footer__contact-info">
          <p>745 Fifth Avenue, Suite 1205<br>New York, NY 10151</p>
          <p>Call us: +1 (212) 758-3388</p>
          <p>Email us: info@verdura.com</p>
        </div>
      </div>

      <div class="verdura-footer__section">
        <h3 class="verdura-footer__section-title">Quick Links</h3>
        <ul class="verdura-footer__links">
          <li class="verdura-footer__link-item">
            <a href="{{ routes.root_url }}/pages/online-accessibility-statement" class="verdura-footer__link">Online Accessibility Statement</a>
          </li>
          <li class="verdura-footer__link-item">
            <a href="{{ routes.root_url }}/pages/catalogues" class="verdura-footer__link">Catalogues</a>
          </li>
          <li class="verdura-footer__link-item">
            <a href="{{ routes.root_url }}/pages/customer-service" class="verdura-footer__link">Customer Service / FAQ</a>
          </li>
        </ul>
      </div>

      <div class="verdura-footer__section">
        <h3 class="verdura-footer__section-title">Collections</h3>
        <ul class="verdura-footer__links">
          <li class="verdura-footer__link-item">
            <a href="{{ routes.root_url }}/collections/bracelets-watches" class="verdura-footer__link">Bracelets & Watches</a>
          </li>
          <li class="verdura-footer__link-item">
            <a href="{{ routes.root_url }}/collections/necklaces" class="verdura-footer__link">Necklaces</a>
          </li>
          <li class="verdura-footer__link-item">
            <a href="{{ routes.root_url }}/collections/rings" class="verdura-footer__link">Rings</a>
          </li>
          <li class="verdura-footer__link-item">
            <a href="{{ routes.root_url }}/collections/earclips" class="verdura-footer__link">Earclips</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="verdura-footer__bottom">
      <div class="verdura-footer__copyright">
        Copyright © {{ 'now' | date: '%Y' }} {{ shop.name }}
      </div>
      <div class="verdura-footer__bottom-links">
        <a href="#" class="verdura-footer__bottom-link">Website by The Beaux Arts</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Verdura Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    }
  ]
}
{% endschema %} 