<style>
  .verdura-newsletter {
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    color: white;
    padding: 80px 0;
    text-align: center;
  }

  .verdura-newsletter__container {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .verdura-newsletter__title {
    font-size: 36px;
    font-weight: 300;
    margin-bottom: 20px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .verdura-newsletter__description {
    font-size: 18px;
    color: #ccc;
    margin-bottom: 40px;
    line-height: 1.6;
  }

  .verdura-newsletter__form {
    display: flex;
    gap: 15px;
    max-width: 500px;
    margin: 0 auto;
  }

  .verdura-newsletter__input {
    flex: 1;
    padding: 16px 20px;
    border: 1px solid #444;
    background: rgba(255,255,255,0.1);
    color: white;
    font-size: 16px;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .verdura-newsletter__input::placeholder {
    color: #999;
  }

  .verdura-newsletter__input:focus {
    outline: none;
    border-color: #d4af37;
    background: rgba(255,255,255,0.15);
  }

  .verdura-newsletter__submit {
    padding: 16px 32px;
    background: #d4af37;
    color: #1a1a1a;
    border: none;
    font-size: 16px;
    font-weight: 600;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .verdura-newsletter__submit:hover {
    background: #c19b2e;
    transform: translateY(-2px);
  }

  .verdura-newsletter__success {
    background: rgba(76, 175, 80, 0.1);
    border: 1px solid #4CAF50;
    color: #4CAF50;
    padding: 20px;
    border-radius: 4px;
    margin-top: 20px;
    display: none;
  }

  .verdura-newsletter__error {
    background: rgba(244, 67, 54, 0.1);
    border: 1px solid #F44336;
    color: #F44336;
    padding: 20px;
    border-radius: 4px;
    margin-top: 20px;
    display: none;
  }

  @media (max-width: 768px) {
    .verdura-newsletter {
      padding: 60px 0;
    }

    .verdura-newsletter__title {
      font-size: 28px;
    }

    .verdura-newsletter__form {
      flex-direction: column;
    }

    .verdura-newsletter__submit {
      width: 100%;
    }
  }
</style>

<div class="verdura-newsletter">
  <div class="verdura-newsletter__container">
    <h2 class="verdura-newsletter__title">
      {% if section.settings.title != blank %}
        {{ section.settings.title }}
      {% else %}
        Sign up now
      {% endif %}
    </h2>
    
    <p class="verdura-newsletter__description">
      {% if section.settings.description != blank %}
        {{ section.settings.description }}
      {% else %}
        Welcome to Verdura. Please join our email list for updates about new collections and special events.
      {% endif %}
    </p>

    <form class="verdura-newsletter__form" id="verdura-newsletter-form">
      <input 
        type="email" 
        name="email" 
        class="verdura-newsletter__input" 
        placeholder="Enter your email address"
        required
      >
      <button type="submit" class="verdura-newsletter__submit">
        Submit
      </button>
    </form>

    <div class="verdura-newsletter__success" id="verdura-newsletter-success">
      Thank you for subscribing to our newsletter!
    </div>

    <div class="verdura-newsletter__error" id="verdura-newsletter-error">
      There was an error. Please try again.
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('verdura-newsletter-form');
    const successMessage = document.getElementById('verdura-newsletter-success');
    const errorMessage = document.getElementById('verdura-newsletter-error');

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const email = form.querySelector('input[name="email"]').value;
        
        // Here you would typically send the email to your newsletter service
        // For now, we'll just show a success message
        successMessage.style.display = 'block';
        errorMessage.style.display = 'none';
        form.reset();
        
        // Hide success message after 5 seconds
        setTimeout(() => {
          successMessage.style.display = 'none';
        }, 5000);
      });
    }
  });
</script>

{% schema %}
{
  "name": "Verdura Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Sign up now"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Welcome to Verdura. Please join our email list for updates about new collections and special events."
    }
  ],
  "presets": [
    {
      "name": "Verdura Newsletter"
    }
  ]
}
{% endschema %} 